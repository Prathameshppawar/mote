{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mote",
  "mainBinaryName": "Mote",
  "version": "1.1.0",
  "identifier": "io.github.prathameshppawar.mote",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVBN0U0NTcwRkQ3MEE2N0QKUldSOXBuRDljRVYrNnVGUWxoaStyT0xKYnB6K1VsUG5sM2dlSENCc0wwNzJPM2Nmb29BQi9wRkcK",
      "endpoints": ["https://github.com/Prathameshppawar/mote/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data:",
        "font-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost"
      },
      "freezePrototype": true,
      "capabilities": ["main-window", "overlay-window", "palette-window"]
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "AI that stays in the flow.",
    "longDescription": "Mote is a local-first, context-aware writing and prompting layer for macOS and Windows. It completes sentences inline, fixes spelling and grammar, enhances AI prompts, and understands Hinglish and romanized Marathi, without leaving the app you are writing in.",
    "copyright": "© 2026 Prathamesh Pawar. MIT License.",
    "publisher": "Prathamesh Pawar",
    "homepage": "https://github.com/Prathameshppawar/mote",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-",
      "infoPlist": "Info.plist"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
