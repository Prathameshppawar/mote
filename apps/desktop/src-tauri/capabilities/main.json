{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "Settings, onboarding, usage dashboard and diagnostics.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "allow-get-app-info",
    "allow-install-update",
    "allow-check-for-updates",
    "allow-get-update-status",
    "allow-get-settings",
    "allow-save-settings",
    "allow-get-provider-status",
    "allow-set-api-key",
    "allow-clear-api-key",
    "allow-test-connection",
    "allow-list-models",
    "allow-get-usage-dashboard",
    "allow-list-pricing",
    "allow-save-pricing",
    "allow-delete-pricing",
    "allow-reset-pricing",
    "allow-clear-usage-history",
    "allow-clear-context",
    "allow-reset-local-data",
    "allow-list-exclusions",
    "allow-add-exclusion",
    "allow-remove-exclusion",
    "allow-list-running-apps",
    "allow-get-always-excluded",
    "allow-get-recent-activity",
    "allow-get-permission-status",
    "allow-request-accessibility-permission",
    "allow-open-accessibility-settings",
    "allow-get-diagnostics",
    "allow-copy-diagnostics",
    "allow-set-paused",
    "allow-complete-onboarding",
    "allow-get-engine-status"
  ]
}
